<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.spectramedix.tableau-agent" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description resource-id="description"/>
    <author name="SpectraMedix" email="support@spectramedix.com" organization="SpectraMedix" website="https://spectramedix.com"/>
    <min-api-version>1.0</min-api-version>
    <source-location>
      <url>https://YOUR_EXTENSION_HOST/index.html</url>
    </source-location>
    <icon/>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text>SpectraMedix Tableau Agent</text>
    </resource>
    <resource id="description">
      <text>Chat with your dashboard to apply filters via AI agent and MCP bridge.</text>
    </resource>
  </resources>
</manifest>
